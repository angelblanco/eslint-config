{
  "name": "@angelblanco/eslint-config",
  "type": "module",
  "version": "3.0.0",
  "packageManager": "pnpm@12.16.1",
  "description": "Ángel Blanco's Eslint Config - based on @antfu/eslint-config",
  "author": "Ángel Blanco",
  "license": "MIT",
  "homepage": "https://github.com/angelblanco/eslint-config#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/angelblanco/eslint-config.git"
  },
  "bugs": {
    "url": "https://github.com/angelblanco/eslint-config/issues"
  },
  "keywords": [
    "eslint",
    "eslint-config"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "tsc --noEmit",
    "build": "tsup index.ts --format cjs,esm --dts",
    "prepare": "pnpm build"
  },
  "peerDependencies": {
    "eslint-plugin-tailwindcss": "^4.4.0"
  },
  "peerDependenciesMeta": {
    "eslint-plugin-tailwindcss": {
      "optional": true
    }
  },
  "dependencies": {
    "@antfu/eslint-config": "^10.0.0"
  },
  "devDependencies": {
    "eslint": "^10.14.0",
    "eslint-plugin-format": "^2.0.1",
    "eslint-plugin-tailwindcss": "^4.4.0",
    "jiti": "^2.7.0",
    "tailwindcss": "^4.3.3",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3"
  }
}
